{
  "compilerOptions": {
    "target": "es2019",
    "module": "esnext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "src/**/*"
  ]
}
